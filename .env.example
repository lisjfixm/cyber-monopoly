# 複製為 .env 並依部署環境填寫
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# PostgreSQL 連線字串（部署必填）
# 優先使用 DATABASE_URL；若未設定則回退到 SUDA_DATABASE_URL（相容舊變數）
DATABASE_URL=postgres://user:password@localhost:5432/cyber_monopoly
# SUDA_DATABASE_URL=postgres://user:password@localhost:5432/cyber_monopoly

# GM 後台密碼（選填，未設定時僅限開發環境）
GM_PASSWORD=

# 帳號 token 簽章密鑰（強烈建議設定，未設定時使用開發用預設值）
ACCOUNT_TOKEN_SECRET=change-me-in-production

# GM 後台 HMAC 簽章密鑰（選填）
GM_HMAC_SECRET=

# OAuth 登入（選填，啟用時需提供對應金鑰）
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_APPLE_CLIENT_ID=

# 日誌
LOG_DIR=./logs
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# 執行環境
NODE_ENV=production
